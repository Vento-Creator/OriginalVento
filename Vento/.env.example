# Vento production environment
API_ID=
API_HASH=
BOT_TOKEN=
SUPER_ADMIN_ID=
SECOND_ADMIN_ID=
ADMIN_REPORT_CHAT_ID=0

# Optional extra API credentials for login code delivery rotation.
# Telegram silently throttles code delivery per api_id under high login volume,
# so spread logins across multiple api_id/api_hash pairs (up to API_ID_10).
# Get more pairs at https://my.telegram.org (one app per Telegram account).
API_ID_2=
API_HASH_2=
API_ID_3=
API_HASH_3=

# Optional
DEBUG_MODE=false
DEBUG_ADMIN_IDS=
VENTO_DATA_DIR=./data
LOG_LEVEL=INFO

# Extra Telegram api_id/api_hash pairs for rotation (up to API_ID_10).
# Each extra pair spreads login volume so Telegram doesn't silently throttle
# code delivery per single api_id.
API_ID_2=
API_HASH_2=
API_ID_3=
API_HASH_3=

# Force SMS code delivery on every login (current_number=False in auth.sendCode).
# Recommended if Telegram prefers in-app delivery and users miss the code.
# Values: true/false (default false)
LOGIN_FORCE_SMS=false
