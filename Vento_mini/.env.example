# Vento Mini Environment Configuration
# Diqqat: BU FAYLDA HAQIQIY TOKEN SAQLAMANG — .env.example gitga commit bo'ladi!

# my.telegram.org dan olingan API ma'lumotlari
API_ID=
API_HASH=

# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Bot egasi(lar)ining Telegram ID lari (vergul bilan, masalan: 8513957498,987654321)
ADMIN_IDS=

# --- MassDM sozlamalari (ixtiyoriy) ---
# Har bir xabar orasidagi pauza (sekund). Default: 10
MASSDM_DELAY=10
# Har bir Premium akkauntning xabar limiti (12 soatga). Default: 50
MASSDM_PER_ACCOUNT_LIMIT=50
# O'chirish jarayonida lichkalar orasidagi pauza (sekund). Default: 0.5
MASSDM_DELETE_STEP_DELAY=0.5

# --- Akkaunt fingerprinti (ixtiyoriy) ---
# Telegram login paytida yuboriladigan qurilma ma'lumotlari.
DEVICE_MODEL=Samsung SM-A136B
APP_VERSION=11.8.4
SYSTEM_VERSION=Android 14
